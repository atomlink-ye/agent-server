{
  "name": "@atomlink-ye/agent-server",
  "version": "0.1.0",
  "description": "Enterprise agent control-plane walking skeleton built on Paseo",
  "private": true,
  "type": "module",
  "exports": {
    "./product-contract": "./src/contracts/product-accepted-subset/index.ts"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev/with-paseo.mjs -- pnpm dev:api",
    "dev:api": "node --import tsx --watch src/entrypoints/api/server.ts",
    "dev:lark": "node --import tsx --watch src/entrypoints/lark/worker.ts",
    "start": "node dist/entrypoints/api/server.js",
    "start:lark": "node dist/entrypoints/lark/worker.js",
    "skill:register": "node --import tsx src/entrypoints/cli/skill-register.ts",
    "agentctl": "node --import tsx src/entrypoints/cli/agentctl.ts",
    "smoke:user-skill": "node scripts/smoke/user-authored-skill-main-flow.mjs",
    "smoke:managed-environment": "node scripts/smoke/managed-environment-main-flow.mjs",
    "smoke:self-learning-team-phase2": "node scripts/smoke/self-learning-team-phase2-main-flow.mjs",
    "smoke:self-learning-team-phase3": "node scripts/smoke/self-learning-team-phase3-main-flow.mjs",
    "smoke:agent-teams-v2": "node scripts/smoke/agent-teams-v2-main-flow.mjs",
    "smoke:product-work-projection": "node scripts/smoke/product-work-durable-identity-main-flow.mjs --phase durable-identity",
    "record:product-run": "node scripts/record/product-projection-real-run.mjs",
    "smoke:product-work-projection-durable-identity": "node scripts/smoke/product-work-durable-identity-main-flow.mjs --phase durable-identity",
    "smoke:product-run-state": "node scripts/smoke/product-run-state-canary.mjs",
    "smoke:s6-state-honesty-negative": "node scripts/smoke/s6-state-honesty-negative.mjs",
    "probe:paseo-stream": "node scripts/probes/paseo-agent-stream.mjs",
    "web:dev": "pnpm --filter @atomlink-ye/agent-server-web dev",
    "web:build": "pnpm --filter @atomlink-ye/agent-server-web build",
    "web:check:types": "pnpm --filter @atomlink-ye/agent-server-web check:types",
    "web:bootstrap": "node scripts/dev/web-bootstrap.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:format": "prettier --check .",
    "check:docs": "node scripts/ci/check-docs.mjs && node --test scripts/ci/check-apache-notice.test.mjs && node scripts/ci/check-apache-notice.mjs",
    "check:exec-plans": "node --test scripts/ci/check-exec-plans.test.mjs && node scripts/ci/check-exec-plans.mjs",
    "modularization:verify:ownership-ledger": "node scripts/ci/ownership-ledger-harness.mjs",
    "modularization:verify:product-routes": "pnpm guard:create-app-product-endpoints",
    "modularization:verify:platform-shell": "node --import tsx scripts/ci/verify-platform-shell.mjs",
    "modularization:verify:work-boundary": "node scripts/ci/check-work-import-boundary.mjs",
    "modularization:acceptance:work-http": "REAL_POSTGRES_REQUIRED=1 vitest run --config vitest.integration.config.ts --no-file-parallelism tests/integration/product-api-v1-oi38.integration.test.ts -t 'requires owner positive control|fails closed|runs the real HTTP'",
    "modularization:acceptance:work-mcp": "REAL_POSTGRES_REQUIRED=1 vitest run --config vitest.integration.config.ts --no-file-parallelism tests/integration/product-api-v1-oi38.integration.test.ts -t 'creates through real MCP' && node scripts/ci/check-work-bootstrap-boundary.mjs",
    "guard:create-app-product-endpoints": "node --import tsx scripts/ci/guard-create-app-product-endpoints.mjs",
    "guard:product-accepted-gate-lineage": "node scripts/ci/verify-product-accepted-gate-lineage.mjs",
    "guard:product-accepted-evidence": "node scripts/ci/verify-product-accepted-guard-evidence.mjs",
    "guard:product-accepted-wiring": "node scripts/ci/check-product-accepted-guard-wiring.mjs",
    "check:product-accepted-subset": "node --import tsx scripts/ci/check-product-accepted-subset.ts --check",
    "guard:product-accepted-subset": "pnpm guard:product-accepted-gate-lineage && pnpm check:product-accepted-subset && pnpm modularization:verify:product-routes",
    "check:backend": "pnpm check:types && pnpm check:format && pnpm check:docs && pnpm check:exec-plans && pnpm modularization:verify:work-boundary && pnpm guard:product-accepted-wiring && pnpm guard:product-accepted-subset",
    "check:web": "pnpm web:check:types",
    "foundation:phase-b": "node scripts/foundation/phase-b.mjs",
    "foundation:deterministic:ci-graph": "node scripts/foundation/phase-b.mjs E2 --candidate-sha ${FOUNDATION_CANDIDATE_SHA:-working-tree}",
    "foundation:deterministic:ci-inventory": "node scripts/foundation/phase-b.mjs E3 --candidate-sha ${FOUNDATION_CANDIDATE_SHA:-working-tree}",
    "foundation:deterministic:identity-script": "node scripts/foundation/phase-b.mjs E8 --candidate-sha ${FOUNDATION_CANDIDATE_SHA:-working-tree}",
    "foundation:acceptance:no-provider-volume": "node scripts/foundation/phase-b.mjs E1 --candidate-sha ${FOUNDATION_CANDIDATE_SHA:-working-tree}",
    "foundation:deterministic": "pnpm foundation:deterministic:ci-graph && pnpm foundation:deterministic:ci-inventory && pnpm foundation:deterministic:identity-script",
    "foundation:acceptance": "pnpm foundation:acceptance:no-provider-volume",
    "check": "pnpm check:backend && pnpm check:web",
    "test": "pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:web",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:real-pg": "REAL_POSTGRES_REQUIRED=1 vitest run --config vitest.integration.config.ts --no-file-parallelism tests/integration/real-pg-pool.integration.test.ts tests/integration/postgres-migration-concurrency.integration.test.ts tests/integration/agent-registry-postgres.integration.test.ts tests/integration/session-lane-postgres.integration.test.ts tests/integration/runtime-memory-real-pg.integration.test.ts tests/integration/run-cancellation-postgres.integration.test.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e:web": "vitest run --config vitest.e2e.config.ts e2e/web-product-session.e2e.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:paseo-smoke": "pnpm build && node scripts/smoke/paseo-opencode.mjs",
    "eval:smoke": "node --import tsx scripts/eval/memory-policy-eval.ts",
    "ci:deterministic": "pnpm check:backend && pnpm check:web && pnpm test:unit && pnpm test:contract && pnpm test:integration && pnpm test:web && pnpm test:e2e && pnpm build",
    "ci": "pnpm check && pnpm test && pnpm test:e2e && pnpm build",
    "clean": "node scripts/dev/clean.mjs",
    "check:fast": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@getpaseo/client": "0.1.110",
    "@hono/node-server": "2.0.11",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.12.31",
    "pg": "8.16.3",
    "re2js": "2.8.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-smoke": "npm:@electric-sql/pglite@0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "prettier": "3.9.6",
    "playwright": "1.62.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
