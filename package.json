{
  "name": "@atomlink-ye/agent-server",
  "version": "0.1.0",
  "description": "Enterprise agent control-plane walking skeleton built on Paseo",
  "private": true,
  "type": "module",
  "exports": {
    "./product-contract": "./src/contracts/product-accepted-subset/index.ts"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm env -- up core",
    "dev:runtime": "pnpm env -- up runtime",
    "dev:full": "pnpm env -- up full",
    "dev:api": "node --import tsx --watch src/entrypoints/api/server.ts",
    "dev:lark": "node --import tsx --watch src/entrypoints/lark/worker.ts",
    "env": "node --import tsx tooling/environment/cli.ts",
    "start": "node dist/entrypoints/api/server.js",
    "start:lark": "node dist/entrypoints/lark/worker.js",
    "skill:register": "node --import tsx src/entrypoints/cli/skill-register.ts",
    "agentctl": "node --import tsx src/entrypoints/cli/agentctl.ts",
    "web:dev": "pnpm --filter @atomlink-ye/agent-server-web dev",
    "web:build": "pnpm --filter @atomlink-ye/agent-server-web build",
    "web:check:types": "pnpm --filter @atomlink-ye/agent-server-web check:types",
    "web:bootstrap": "node scripts/dev/web-bootstrap.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm test:repository && pnpm web:check:types",
    "test": "pnpm test:unit && pnpm test:contract && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:repository": "vitest run --config vitest.repository.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:real-pg": "vitest run --config vitest.real-pg.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e:web": "vitest run --config vitest.e2e.config.ts e2e/web-product-session.e2e.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "smoke:runtime": "pnpm env -- run runtime -- node scripts/smoke/runtime-main-flow.mjs",
    "smoke:agent-team": "pnpm env -- run runtime -- node scripts/smoke/agent-team-main-flow.mjs",
    "eval:memory": "node --import tsx evals/memory-policy/run.ts",
    "ci": "pnpm check && pnpm test && pnpm test:e2e && pnpm build",
    "clean": "node scripts/dev/clean.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.1.110",
    "@hono/node-server": "2.0.11",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.12.31",
    "pg": "8.16.3",
    "re2js": "2.8.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser-playwright": "4.1.10",
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-smoke": "npm:@electric-sql/pglite@0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "prettier": "3.9.6",
    "playwright": "1.62.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
