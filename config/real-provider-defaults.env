# Canonical defaults for the optional real-provider development flow.
PASEO_PROVIDER=claude
PASEO_MODEL=opencode-go/deepseek-v4-flash
PASEO_EXECUTION_TIMEOUT_MS=600000
PASEO_SESSION_RPC_TIMEOUT_MS=1200000
PASEO_OPENCODE_APP_AGENTS_TIMEOUT_MS=120000
PASEO_OPENCODE_PROVIDER_LIST_TIMEOUT_MS=120000
PASEO_OPENCODE_SERVER_STARTUP_TIMEOUT_MS=300000
PASEO_OPENCODE_SESSION_CREATE_TIMEOUT_MS=300000
PASEO_PROVIDER_REFRESH_TIMEOUT_MS=180000
PASEO_DAEMON_STARTUP_TIMEOUT_MS=420000
