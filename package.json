{
  "name": "@atomlink-ye/agent-server",
  "version": "0.1.0",
  "description": "Enterprise agent control-plane walking skeleton built on Paseo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev/with-paseo.mjs -- pnpm dev:api",
    "dev:api": "node --import tsx --watch src/entrypoints/api/server.ts",
    "dev:lark": "node --import tsx --watch src/entrypoints/lark/worker.ts",
    "start": "node dist/entrypoints/api/server.js",
    "start:lark": "node dist/entrypoints/lark/worker.js",
    "skill:register": "node --import tsx src/entrypoints/cli/skill-register.ts",
    "smoke:user-skill": "node scripts/smoke/user-authored-skill-main-flow.mjs",
    "smoke:managed-environment": "node scripts/smoke/managed-environment-main-flow.mjs",
    "smoke:team-dag": "node scripts/smoke/team-dag-main-flow.mjs",
    "smoke:team-dag:inspect": "node scripts/smoke/team-dag-retained-inspect.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "check:format": "prettier --check .",
    "check:docs": "node scripts/ci/check-docs.mjs",
    "check:exec-plans": "node --test scripts/ci/check-exec-plans.test.mjs && node scripts/ci/check-exec-plans.mjs",
    "check": "pnpm check:types && pnpm check:format && pnpm check:docs && pnpm check:exec-plans",
    "test": "pnpm test:unit && pnpm test:contract && pnpm test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:real-pg": "REAL_POSTGRES_REQUIRED=1 vitest run --config vitest.integration.config.ts tests/integration/real-pg-pool.integration.test.ts tests/integration/postgres-migration-concurrency.integration.test.ts tests/integration/agent-registry-postgres.integration.test.ts tests/integration/session-lane-postgres.integration.test.ts tests/integration/runtime-memory-real-pg.integration.test.ts tests/integration/run-cancellation-postgres.integration.test.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:paseo-smoke": "pnpm build && node scripts/smoke/paseo-opencode.mjs",
    "eval:smoke": "node --import tsx scripts/eval/memory-policy-eval.ts",
    "ci": "pnpm check && pnpm test && pnpm test:e2e && pnpm build",
    "clean": "node scripts/dev/clean.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.1.110",
    "@hono/node-server": "2.0.11",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "4.12.31",
    "pg": "8.16.3",
    "re2js": "2.8.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "opencode-darwin-arm64": "1.18.4",
    "opencode-darwin-x64": "1.18.4",
    "opencode-linux-arm64": "1.18.4",
    "opencode-linux-x64": "1.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-smoke": "npm:@electric-sql/pglite@0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@getpaseo/cli": "0.1.110",
    "@types/node": "22.20.1",
    "@types/pg": "8.15.5",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
