#!/bin/sh

# Callers enter the repository root before sourcing this file. Keep this POSIX
# so it also works inside multi-line Make recipes whose shell is /bin/sh.
defaults_file="${REAL_PROVIDER_DEFAULTS_FILE:-config/real-provider-defaults.env}"
defaults_content=$(sed -n '/^[[:space:]]*#/d;/^[[:space:]]*$/d;p' "$defaults_file")
while IFS='=' read -r name value; do
  case "$name" in
    PASEO_PROVIDER|PASEO_MODEL|PASEO_EXECUTION_TIMEOUT_MS|PASEO_SESSION_RPC_TIMEOUT_MS|PASEO_OPENCODE_APP_AGENTS_TIMEOUT_MS|PASEO_OPENCODE_PROVIDER_LIST_TIMEOUT_MS|PASEO_OPENCODE_SERVER_STARTUP_TIMEOUT_MS|PASEO_OPENCODE_SESSION_CREATE_TIMEOUT_MS|PASEO_PROVIDER_REFRESH_TIMEOUT_MS|PASEO_DAEMON_STARTUP_TIMEOUT_MS) ;;
    *) continue ;;
  esac
  eval "current_value=\${$name-}"
  current_trimmed=$(printf '%s' "$current_value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  if [ -z "$current_trimmed" ]; then export "$name=$value"; fi
done <<EOF
$defaults_content
EOF
