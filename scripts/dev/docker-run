#!/usr/bin/env bash
set -Eeuo pipefail

postgres=0
bind_local=0
pass_env=()
publish_port=''

while (($#)); do
  case "$1" in
    --postgres)
      postgres=1
      shift
      ;;
    --bind-local)
      bind_local=1
      shift
      ;;
    --pass-env)
      (($# >= 2)) || { printf '%s\n' 'docker-run: --pass-env requires a variable name' >&2; exit 2; }
      [[ "$2" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { printf 'docker-run: invalid environment variable name: %s\n' "$2" >&2; exit 2; }
      pass_env+=("$2")
      shift 2
      ;;
    --publish)
      (($# >= 2)) || { printf '%s\n' 'docker-run: --publish requires a TCP port' >&2; exit 2; }
      [[ "$2" =~ ^[0-9]+$ ]] || { printf 'docker-run: invalid TCP port: %s\n' "$2" >&2; exit 2; }
      ((10#$2 >= 1 && 10#$2 <= 65535)) || { printf 'docker-run: TCP port out of range: %s\n' "$2" >&2; exit 2; }
      [[ -z "$publish_port" ]] || { printf '%s\n' 'docker-run: only one --publish port is supported' >&2; exit 2; }
      publish_port="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      printf '%s\n' 'docker-run: expected --postgres, --bind-local, --pass-env NAME, --publish PORT, or --' >&2
      exit 2
      ;;
  esac
done

(($#)) || { printf '%s\n' 'docker-run: a command is required after --' >&2; exit 2; }

# Pin the compose project name. It otherwise defaults to the working directory's
# basename, so the same image gets a different tag in every git worktree and in
# every sandbox whose remote workspace is named after its lane — which defeats
# the prebuilt image baked into the sandbox template (a matching tag builds in
# ~1.5 minutes, a mismatched one pays the full image export again).
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-agent-server}"

compose=(docker compose)
existing_postgres_test_id=''
started_postgres_test=0
if ((postgres)); then
  existing_postgres_test_id="$("${compose[@]}" --profile postgres-test ps -aq postgres-test 2>/dev/null || true)"
fi
cleanup() {
  local exit_status=$?
  if ((postgres && started_postgres_test)) && [[ -z "$existing_postgres_test_id" ]]; then
    "${compose[@]}" --profile postgres-test rm -sf postgres-test >/dev/null 2>&1 || true
  fi
  return "$exit_status"
}
forward_signal() {
  local signal="$1"
  local signal_status=143
  if [[ "$signal" == INT ]]; then
    signal_status=130
  fi
  if [[ -n "${child_pid:-}" ]]; then
    kill -"$signal" "$child_pid" 2>/dev/null || true
    if wait "$child_pid"; then
      :
    else
      :
    fi
  fi
  exit "$signal_status"
}
trap cleanup EXIT
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

if ((postgres)); then
  if [[ -z "$existing_postgres_test_id" ]]; then
    started_postgres_test=1
  fi
  "${compose[@]}" --profile postgres-test up -d --wait postgres-test
fi

env_args=()
if ((postgres)); then
  env_args+=(
    -e DATABASE_URL=postgresql://agent:agent@postgres-test:5432/agent_server
    -e POSTGRES_URL=postgresql://agent:agent@postgres-test:5432/agent_server
    -e POSTGRES_ADMIN_URL=postgresql://agent:agent@postgres-test:5432/agent_server
  )
fi
if ((${#pass_env[@]})); then
  for name in "${pass_env[@]}"; do
    if [[ -n ${!name:-} ]]; then
      env_args+=(-e "$name=${!name}")
    fi
  done
fi
run_args=(run --rm --no-deps)
if [[ -n "$publish_port" ]]; then
  run_args+=(-p "127.0.0.1:${publish_port}:${publish_port}")
fi
if ((bind_local)); then
  mkdir -p .local
  run_args+=(-v "$(pwd)/.local:/workspace/.local")
fi
if ((${#env_args[@]})); then
  run_args+=("${env_args[@]}")
fi
run_args+=(runner "$@")
"${compose[@]}" "${run_args[@]}" &
child_pid=$!
if wait "$child_pid"; then
  child_status=$?
else
  child_status=$?
fi
exit "$child_status"
