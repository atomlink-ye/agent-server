NODE_ENV=development
# Host-native diagnostic binding only; Compose overrides this to 0.0.0.0 inside
# the container and publishes the API only on host loopback 127.0.0.1:3000.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=agent-server
# Docker Compose supplies DATABASE_URL and keeps PostgreSQL private to its network.
# Host-native diagnostics may use DATABASE_URL=postgresql://localhost:5432/agent_server.
# Docker Compose supplies the Paseo URL at runtime; this loopback value is for
# the co-process development launcher and is never a host Paseo mount.
PASEO_WS_URL=ws://127.0.0.1:6767/ws
PASEO_AGENT_CWD=.local/agent-workspace
PASEO_WORKSPACE_TITLE=Agent Server Baseline
# Optional explicit operator override. The API never accepts a model from callers.
# PASEO_MODEL=opencode/mimo-v2.5-free
PASEO_CONNECT_TIMEOUT_MS=10000
PASEO_EXECUTION_TIMEOUT_MS=120000
