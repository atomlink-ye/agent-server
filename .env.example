NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=agent-server

# `pnpm setup` / `pnpm dev` are host-native. When DATABASE_URL is omitted the
# developer harness uses local PostgreSQL when reachable, otherwise starts a
# persistent PGlite wire server under .local/dev-runtime.
# Set DATABASE_URL explicitly to keep using a real PostgreSQL instance.
# DATABASE_URL=postgresql://your-user@127.0.0.1:5432/agent_server_dev
# PGLITE_PORT=55432

# Real PostgreSQL semantic tests are opt-in and MUST use a dedicated database
# whose name contains "test". The runner refuses prod/main/live-looking names.
# TEST_DATABASE_URL=postgresql://your-user@127.0.0.1:5432/agent_server_test

# Core host-native development does not require Paseo. `pnpm dev:runtime` and
# the explicit canary commands use this host-local runtime endpoint.
PASEO_WS_URL=ws://127.0.0.1:6767/ws
PASEO_AGENT_CWD=.local/agent-workspace
PASEO_RUNTIME_CELL_ROOT=.local/runtime-cells
PASEO_WORKSPACE_TITLE=Agent Server Baseline

# Runtime MCP is provider-visible state. Use a stable port so a durable provider
# session never points at a process-random endpoint after Agent Server restarts.
# Tests that omit this value intentionally use an ephemeral listener.
RUNTIME_MCP_LISTEN_HOST=127.0.0.1
RUNTIME_MCP_ADVERTISED_HOST=127.0.0.1
RUNTIME_MCP_PORT=39117

# Real-provider defaults are maintained in config/real-provider-defaults.env and
# loaded by the runtime helper. Override them explicitly when needed.
# Real provider access requires operator-supplied credentials; never commit
# OPENCODE_GO_API_KEY or another provider secret here.
PASEO_CONNECT_TIMEOUT_MS=10000
PASEO_EXECUTION_TIMEOUT_MS=120000
AGENT_SERVER_DISPATCHER_CONCURRENCY=4
AGENT_SERVER_CHAT_ACTIVATION_BURST_DEBOUNCE_MS=2000

# The Claude provider can reach a model over AWS Bedrock instead of the default
# Anthropic-compatible gateway. The runtime helpers forward these names into the
# Paseo daemon, and the launch policy then selects a Bedrock-compatible Claude
# permission mode. See docs/development.md "Claude Code transports".
# Never commit a token here.
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_SKIP_BEDROCK_AUTH=1
# ANTHROPIC_BEDROCK_BASE_URL=https://your-bedrock-endpoint
# ANTHROPIC_AUTH_TOKEN=
# PASEO_MODEL=us.anthropic.claude-...
