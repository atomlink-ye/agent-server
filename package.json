{
  "name": "agent-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && echo '<!DOCTYPE html><html><body>agent-server</body></html>' > dist/index.html",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:local": "TEST_BASE_URL=http://localhost:3001 vitest run tests/e2e",
    "test:e2e:docker": "TEST_BASE_URL=http://localhost:13000 vitest run tests/e2e",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
