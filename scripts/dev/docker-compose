#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

runtime_compose=0
if [[ -n "${COMPOSE_FILE:-}" ]]; then
  printf '%s\n' 'docker-compose: COMPOSE_FILE is unsupported; select compose.runtime.yaml explicitly with -f/--file' >&2
  exit 2
fi
is_runtime_file() {
  local candidate="$1"
  case "$candidate" in
    compose.runtime.yaml|./compose.runtime.yaml|"$repo_root/compose.runtime.yaml") return 0 ;;
  esac
  if [[ "$candidate" != /* ]]; then
    candidate="$repo_root/$candidate"
  fi
  local candidate_dir
  candidate_dir="$(cd "$(dirname "$candidate")" 2>/dev/null && pwd -P)" || return 1
  [[ "$candidate_dir/$(basename "$candidate")" == "$repo_root/compose.runtime.yaml" ]]
}
for ((arg_index = 1; arg_index <= $#; arg_index++)); do
  arg="${!arg_index}"
  case "$arg" in
    -f|--file)
      ((arg_index < $#)) || { printf '%s\n' 'docker-compose: -f/--file requires a path' >&2; exit 2; }
      ((arg_index++))
      is_runtime_file "${!arg_index}" && runtime_compose=1
      ;;
    --file=*)
      is_runtime_file "${arg#--file=}" && runtime_compose=1
      ;;
    -f=*)
      is_runtime_file "${arg#-f=}" && runtime_compose=1
      ;;
  esac
done

if ((runtime_compose)); then
  # Keep the checked-in real-provider defaults as the source of defaults while
  # preserving any value already supplied by the operator/environment.
  . "$repo_root/scripts/dev/source-real-provider-defaults"
fi

arch="$(uname -m)"
node_abi="${AGENT_SERVER_NODE_ABI:-137}"
volume_args=("$repo_root" "$arch" "$node_abi")
if ((runtime_compose)); then
  volume_args+=(--include-provider)
fi
volume_json="$(node scripts/dev/compose-volume-environment.mjs "${volume_args[@]}")"
volume_env_file="$(mktemp "${TMPDIR:-/tmp}/agent-server-compose-volume-env.XXXXXX")"
trap 'rm -f -- "$volume_env_file"' EXIT
node -e 'const value=JSON.parse(process.argv[1]); for (const [name,item] of Object.entries(value)) process.stdout.write(`${name}\0${item}\0`)' "$volume_json" >"$volume_env_file"
while IFS= read -r -d '' name && IFS= read -r -d '' value; do
  export "$name=$value"
done <"$volume_env_file"
root_volume="$NODE_MODULES_VOLUME"
web_volume="$WEB_NODE_MODULES_VOLUME"
provider_volume=''
if ((runtime_compose)); then
  provider_volume="$PROVIDER_TOOLCHAIN_VOLUME"
fi

docker volume create "$root_volume" >/dev/null
docker volume create "$web_volume" >/dev/null
if ((runtime_compose)); then
  docker volume create "$provider_volume" >/dev/null
fi

compose_options=()
skip_next=0
for arg in "$@"; do
  if ((skip_next)); then
    compose_options+=("$arg")
    skip_next=0
    continue
  fi
  case "$arg" in
    -f|--file|-p|--project-name|--project-directory|--env-file|--profile|--ansi|--progress)
      compose_options+=("$arg")
      skip_next=1
      ;;
    --file=*|-f=*|-p=*|--project-name=*|--project-directory=*|--env-file=*|--profile=*|--ansi=*|--progress=*)
      compose_options+=("$arg")
      ;;
  esac
done
raw_compose=(docker compose "${compose_options[@]}")
compose_command=''
skip_next=0
for arg in "$@"; do
  if ((skip_next)); then
    skip_next=0
    continue
  fi
  case "$arg" in
    -f|--file|-p|--project-name|--project-directory|--env-file|--profile|--ansi|--progress)
      skip_next=1
      continue
      ;;
    --*) continue ;;
    -*) continue ;;
  esac
  compose_command="$arg"
  break
done
should_provision=1
case "$compose_command" in
  build|config|images|ps|version|volume|down|rm|logs|top|port|events|wait) should_provision=0 ;;
esac

has_build=0
for arg in "$@"; do
  [[ "$arg" == "--build" ]] && has_build=1
done

if ((should_provision)); then
  # Ensure the existing project image is available for the one-shot root
  # ownership provisioning command. This keeps `up --build` compatible with
  # the prebuilt agent-server-runner:latest image without adding an image.
  if ((has_build)); then
    "${raw_compose[@]}" build runner
  fi
  "${raw_compose[@]}" run --rm --no-deps --user 0 --entrypoint /bin/sh runner -c \
    'mkdir -p /workspace/evidence/recordings /workspace/evidence/gate-json /workspace/evidence/run-logs && chown 1000:1000 /workspace/node_modules /workspace/apps/web/node_modules /workspace/evidence/recordings /workspace/evidence/gate-json /workspace/evidence/run-logs'
  if ((runtime_compose)); then
    "${raw_compose[@]}" run --rm --no-deps --user 0 --entrypoint /bin/sh provider-toolchain-init -c \
      'mkdir -p /opt/provider-toolchain-volume && chown 1000:1000 /opt/provider-toolchain-volume'
    "${raw_compose[@]}" run --rm --no-deps provider-toolchain-init
  fi
fi

exec docker compose "$@"
